            "m_Id": "385d363fbdb4158c8ccf54523b125d12"
        },
        {
            "m_Id": "69103ede2f60f485acdac55dd4a86c13"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GetColor",
    "m_FunctionSource": "",
    "m_FunctionBody": "if (XOffset > 0.75) {\r\nif (YOffset < 0.05)\r\nOut = OralCavityColor;\r\n\telse if (YOffset < 0.1)\r\n\t\tOut = TeethColor;\r\n\telse\r\n\t\tOut = (UseGradient) ? (SkinColor * YOffset) : SkinColor;;\r\n}\r\nelse if (XOffset < 0.75 && XOffset > 0.5)\r\nOut = (UseGradient) ? (EyeColor * YOffset) : EyeColor;\r\nelse if (XOffset < 0.5 && XOffset > 0.25)\r\nOut = (UseGradient) ? (HairColor * YOffset) : HairColor;\r\nelse\r\nOut = (UseGradient) ? (UnderPantsColor * YOffset) : UnderPantsColor;"
}

